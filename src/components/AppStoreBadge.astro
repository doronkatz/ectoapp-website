---
interface Props {
    compact?: boolean;
    class?: string;
}

const { compact = false, class: className = '' } = Astro.props;
const sizeClasses = compact
    ? 'px-3 py-2 text-sm'
    : 'px-4 py-3 text-base sm:px-5 sm:py-3.5';
---

<span
    class:list={[
        'inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-black text-white shadow-lg shadow-black/20 transition hover:border-white/30 hover:bg-zinc-900',
        sizeClasses,
        className,
    ]}
>
    <svg
        class="h-5 w-5 flex-none"
        viewBox="0 0 24 24"
        role="img"
        aria-label="Apple"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            fill="currentColor"
            d="M16.64 12.54c-.03-2.64 2.16-3.9 2.26-3.96-1.24-1.82-3.16-2.07-3.83-2.1-1.61-.17-3.18.96-4 0-.83-.94-2.09-.08-3.18-.05-1.64.05-3.17.98-4.01 2.49-1.73 3-.44 7.42 1.22 9.84.83 1.19 1.8 2.52 3.09 2.47 1.25-.05 1.72-.79 3.23-.79 1.5 0 1.94.79 3.25.76 1.35-.02 2.2-1.2 3-2.4.96-1.37 1.34-2.72 1.35-2.79-.03-.01-2.35-.9-2.38-3.47ZM14.02 4.77c.67-.83 1.13-1.95 1-3.08-.97.04-2.18.67-2.88 1.48-.62.72-1.18 1.89-1.03 2.99 1.09.08 2.21-.55 2.91-1.39Z"
        />
    </svg>
    <span class="leading-none">
        {!compact && <span class="block text-[0.62rem] font-medium uppercase tracking-[0.16em] text-white/70">Available on the</span>}
        <span class={compact ? 'font-semibold' : 'block text-lg font-semibold tracking-normal'}>App Store</span>
    </span>
</span>
