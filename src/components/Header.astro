---
import Logo from '../components/Logo.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import XLogo from '../components/XLogo.astro';

const APP_STORE_URL = 'https://apps.apple.com/us/app/ecto/id6758278992';
---

<nav class="flex flex-wrap items-center gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/">
        <Logo />
    </a>
    <a
        href="https://twitter.com/ectoBlogApp"
        target="_blank"
        rel="noreferrer"
        aria-label="Follow @ectoBlogApp on X"
        class="inline-flex items-center justify-center rounded-full border border-white/20 p-2 text-white/80 transition hover:text-white no-underline"
    >
        <XLogo class="h-5 w-5" />
    </a>
    <a href={APP_STORE_URL} target="_blank" rel="noreferrer" class="ml-auto no-underline" aria-label="Open Ecto on the App Store">
        <AppStoreBadge compact />
    </a>
</nav>
