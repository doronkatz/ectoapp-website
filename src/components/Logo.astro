---
import logoIcon from '../assets/Logo-icon.png';
---

<div class="flex items-center gap-3">
    <img
        src={logoIcon.src}
        alt="Ecto App logo"
        width={logoIcon.width}
        height={logoIcon.height}
        loading="lazy"
        decoding="async"
        class="h-12 w-12 rounded-2xl bg-white/10 p-1.5 shadow-lg shadow-primary/40 sm:h-14 sm:w-14"
    />
    <div class="leading-tight">
        <p class="text-base font-semibold text-white sm:text-lg">Ecto App</p>
        <p class="text-xs font-semibold uppercase tracking-[0.4em] text-white/60">Beta</p>
    </div>
</div>
