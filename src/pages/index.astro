---
import Layout from '../layouts/Layout.astro';
import XLogo from '../components/XLogo.astro';
import heroScreenshot from '../assets/Screenshot-1-Tilt.png';
import snapshotScreenshot from '../assets/Screenshot-2-Tilt.png';

const heroStats = [
  { label: 'Creators on the list', value: '320+' },
  { label: 'Average reply time', value: '<12 hrs' },
];

const snapshotPoints = [
  'Check drafts, stats, and comments from any device.',
  'Push updates straight to your Ghost site without opening a laptop.',
  'Keep collaborators aligned with share-ready cards.',
];

const primerPoints = [
  'Ghost is an open-source publishing platform built for newsletters and modern media brands.',
  'Creators host their sites on Ghost to own their audience, subscriptions, and data.',
  'Ghost App lets you manage that entire stack from your phone or tablet.',
];

const trustSignals = [
  'Used by indie publishers worldwide',
  'Built with Ghost’s official APIs',
  'Manual onboarding for every cohort',
];

interface XPost {
  id: string;
  title: string;
  excerpt: string;
  link: string;
  dateLabel: string;
}

const X_HANDLE = 'ghostBlogApp';
const X_HANDLE_DISPLAY = `@${X_HANDLE}`;
const X_PROFILE_URL = `https://twitter.com/${X_HANDLE}`;
const X_FEED_ENDPOINT = '/api/x-feed.json';

const fallbackXPosts: XPost[] = [
  {
    id: 'fallback-1',
    title: 'Shipping threads, beta wins, and Ghost tips land on X first.',
    excerpt: 'Follow @ghostBlogApp to catch behind-the-scenes updates while we build the mobile companion.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
  {
    id: 'fallback-2',
    title: 'Release notes and roadmap chatter in one feed.',
    excerpt: 'We post cohort announcements, feature drops, and integration news on X as they roll out.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
  {
    id: 'fallback-3',
    title: 'Have a question? DM @ghostBlogApp on X.',
    excerpt: 'Reach out for onboarding help, roadmap context, or to share your Ghost setup.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
];

const xPosts = fallbackXPosts;
---

<Layout title="Ghost App | Modern beta storytelling">
  <Fragment slot="head">
    <script id="mcjs">!function(c,h,i,m,p){m=c.createElement(h),p=c.getElementsByTagName(h)[0],m.async=1,m.src=i,p.parentNode.insertBefore(m,p)}(document,"script","https://chimpstatic.com/mcjs-connected/js/users/a5d59cae185f37394a689cc2c/52a6f3291daa72dc56ad652af.js");</script>
  </Fragment>
  <section id="hero" class="grid gap-10 pb-16 pt-6 text-white lg:grid-cols-[1.1fr_minmax(0,0.9fr)]">
    <div class="space-y-6">
      <span class="tag">Private beta now recruiting</span>
      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">
        Manage your Ghost publication anywhere with Ghost App.
      </h1>
      <p class="text-lg text-white/80 sm:text-xl">
        Draft, review, and publish posts without opening a laptop. Ghost App brings real-time stats, audience signals, and approvals into a minimalist mobile workspace.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#waitlist" class="btn btn-lg sm:min-w-48">Join the beta</a>
        <a href="#ghost-primer" class="inline-flex items-center gap-2 font-semibold text-white/80 transition hover:text-white">
          New to Ghost? Start here →
        </a>
      </div>
      <p class="text-sm text-white/70">
        Follow
        <a href={X_PROFILE_URL} target="_blank" rel="noreferrer" class="font-semibold text-white hover:text-primary">
          @ghostBlogApp
        </a>
        on X (Twitter) for beta updates and feature drops.
      </p>
      <div class="grid gap-6 pt-4 text-sm uppercase tracking-wide text-white/70 sm:grid-cols-2">
        {heroStats.map((stat) => (
          <div class="space-y-1">
            <p class="text-2xl font-bold text-white">{stat.value}</p>
            <p class="text-xs tracking-[0.3em] text-white/60">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="relative">
      <div class="absolute -inset-6 rounded-[2.75rem] bg-gradient-to-br from-primary/40 via-white/10 to-primary/20 blur-3xl"></div>
      <div class="surface-card relative flex items-center justify-center overflow-hidden rounded-[2.75rem] border border-white/10 bg-gradient-to-b from-white/10 to-white/0 p-8">
        <img
          src={heroScreenshot.src}
          alt="Ghost App mobile workspace preview"
          width={heroScreenshot.width}
          height={heroScreenshot.height}
          loading="lazy"
          class="max-h-[640px] w-full max-w-sm object-contain drop-shadow-[0_25px_80px_rgba(0,0,0,0.35)]"
        />
      </div>
    </div>
