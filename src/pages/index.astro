---
import Layout from '../layouts/Layout.astro';
import XLogo from '../components/XLogo.astro';
import heroScreenshot from '../assets/Screenshot-1-Tilt.png';
import snapshotScreenshot from '../assets/Screenshot-2-Tilt.png';

const heroStats = [
  { label: 'Creators on the list', value: '320+' },
  { label: 'Average reply time', value: '<12 hrs' },
];

const snapshotPoints = [
  'Check drafts, stats, and comments from any device.',
  'Push updates straight to your Ghost site without opening a laptop.',
  'Keep collaborators aligned with share-ready cards.',
];

const primerPoints = [
  'Ghost is an open-source publishing platform built for newsletters and modern media brands.',
  'Creators host their sites on Ghost to own their audience, subscriptions, and data.',
  'Ghost App lets you manage that entire stack from your phone or tablet.',
];

const trustSignals = [
  'Used by indie publishers worldwide',
  'Built with Ghost’s official APIs',
  'Manual onboarding for every cohort',
];

interface XPost {
  id: string;
  title: string;
  excerpt: string;
  link: string;
  dateLabel: string;
}

const X_HANDLE = 'ghostBlogApp';
const X_HANDLE_DISPLAY = `@${X_HANDLE}`;
const X_PROFILE_URL = `https://twitter.com/${X_HANDLE}`;
const X_FEED_ENDPOINT = '/api/x-feed.json';

const fallbackXPosts: XPost[] = [
  {
    id: 'fallback-1',
    title: 'Shipping threads, beta wins, and Ghost tips land on X first.',
    excerpt: 'Follow @ghostBlogApp to catch behind-the-scenes updates while we build the mobile companion.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
  {
    id: 'fallback-2',
    title: 'Release notes and roadmap chatter in one feed.',
    excerpt: 'We post cohort announcements, feature drops, and integration news on X as they roll out.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
  {
    id: 'fallback-3',
    title: 'Have a question? DM @ghostBlogApp on X.',
    excerpt: 'Reach out for onboarding help, roadmap context, or to share your Ghost setup.',
    link: X_PROFILE_URL,
    dateLabel: 'Live feed',
  },
];

const xPosts = fallbackXPosts;
---

<Layout title="Ghost App | Modern beta storytelling">
  <Fragment slot="head">
    <script id="mcjs">!function(c,h,i,m,p){m=c.createElement(h),p=c.getElementsByTagName(h)[0],m.async=1,m.src=i,p.parentNode.insertBefore(m,p)}(document,"script","https://chimpstatic.com/mcjs-connected/js/users/a5d59cae185f37394a689cc2c/52a6f3291daa72dc56ad652af.js");</script>
  </Fragment>
  <section id="hero" class="grid gap-10 pb-16 pt-6 text-white lg:grid-cols-[1.1fr_minmax(0,0.9fr)]">
    <div class="space-y-6">
      <span class="tag">Private beta now recruiting</span>
      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">
        Manage your Ghost publication anywhere with Ghost App.
      </h1>
      <p class="text-lg text-white/80 sm:text-xl">
        Draft, review, and publish posts without opening a laptop. Ghost App brings real-time stats, audience signals, and approvals into a minimalist mobile workspace.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#waitlist" class="btn btn-lg sm:min-w-48">Join the beta</a>
        <a href="#ghost-primer" class="inline-flex items-center gap-2 font-semibold text-white/80 transition hover:text-white">
          New to Ghost? Start here →
        </a>
      </div>
      <p class="text-sm text-white/70">
        Follow
        <a href={X_PROFILE_URL} target="_blank" rel="noreferrer" class="font-semibold text-white hover:text-primary">
          @ghostBlogApp
        </a>
        on X (Twitter) for beta updates and feature drops.
      </p>
      <div class="grid gap-6 pt-4 text-sm uppercase tracking-wide text-white/70 sm:grid-cols-2">
        {heroStats.map((stat) => (
          <div class="space-y-1">
            <p class="text-2xl font-bold text-white">{stat.value}</p>
            <p class="text-xs tracking-[0.3em] text-white/60">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="relative">
      <div class="absolute -inset-6 rounded-[2.75rem] bg-gradient-to-br from-primary/40 via-white/10 to-primary/20 blur-3xl"></div>
      <div class="surface-card relative flex items-center justify-center overflow-hidden rounded-[2.75rem] border border-white/10 bg-gradient-to-b from-white/10 to-white/0 p-8">
        <img
          src={heroScreenshot.src}
          alt="Ghost App mobile workspace preview"
          width={heroScreenshot.width}
          height={heroScreenshot.height}
          loading="lazy"
          class="max-h-[640px] w-full max-w-sm object-contain drop-shadow-[0_25px_80px_rgba(0,0,0,0.35)]"
        />
      </div>
    </div>
  </section>
  <div class="surface-card mb-10 rounded-3xl border border-amber-400/40 bg-amber-500/10 p-6 text-amber-50">
    <p class="text-xs uppercase tracking-[0.3em] text-amber-200">Disclaimer</p>
    <p class="mt-3 text-base text-amber-50">
      Ghost App, its content, and visuals represent work-in-progress beta materials. Features, availability, and onboarding timelines may change
      without notice, and joining the waitlist does not guarantee cohort placement.
    </p>
  </div>
  <section id="snapshot" class="space-y-10 py-16">
    <div class="space-y-4">
      <span class="tag">Ghost App snapshot</span>
      <h2 class="text-3xl sm:text-4xl">One mobile canvas for creators and editors.</h2>
      <p class="text-lg text-white/75 sm:max-w-3xl">
        Give visitors a quick read on what Ghost App does before they dive deeper. Swap in your own metrics and visuals later.
      </p>
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.15fr_minmax(0,0.85fr)]">
      <div class="space-y-10">
        <div class="space-y-6 text-white/80">
          {snapshotPoints.map((point) => (
            <div class="flex items-start gap-3 text-base">
              <span class="mt-1 h-2 w-2 rounded-full bg-primary shadow shadow-primary/40"></span>
              <p>{point}</p>
            </div>
          ))}
          <div class="grid gap-4 pt-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">2x</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">Faster draft turnaround</p>
            </div>
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">94%</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">Beta satisfaction</p>
            </div>
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">0</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">Laptop required</p>
            </div>
          </div>
        </div>
        <div id="waitlist" class="surface-card space-y-6 bg-gradient-to-b from-white/10 to-transparent p-8 sm:p-10">
          <div class="space-y-4">
            <span class="tag">Beta waitlist</span>
            <h3 class="text-2xl sm:text-3xl text-white">Sign up to be on the waiting list</h3>
            <p class="text-base text-white/75">
              Put your name and Apple ID email address below, and we will send you a TestFlight beta when we are ready. We won't use your email
              address for anything else, or share your email address with anyone.
            </p>
          </div>

          <div id="mc_embed_shell" class="space-y-4">
            <form
              action="https://ghostapp.us6.list-manage.com/subscribe/post?u=a5d59cae185f37394a689cc2c&amp;id=f3e83a9de2&amp;f_id=00e4c2e1f0"
              method="post"
              target="_blank"
              class="space-y-6"
            >
              <div class="space-y-2">
                <label for="mc-email" class="text-base font-semibold text-white">Email address</label>
                <input
                  id="mc-email"
                  name="EMAIL"
                  type="email"
                  required
                  placeholder="you@example.com"
                  class="w-full rounded-2xl border border-white/30 bg-white/10 px-4 py-4 text-lg text-white placeholder-white/50 focus:border-primary focus:outline-none focus:ring-0"
                />
                <p class="text-sm text-white/70">We'll send your TestFlight invite here.</p>
              </div>
              <div aria-hidden="true" style="position: absolute; left: -5000px;">
                <input type="text" name="b_a5d59cae185f37394a689cc2c_f3e83a9de2" tabindex="-1" value="" />
              </div>
              <button type="submit" class="btn btn-lg w-full sm:w-auto">Join the waitlist</button>
              <p class="text-xs text-white/60">Powered by Intuit Mailchimp</p>
            </form>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="surface-card relative flex h-full w-full items-center justify-center overflow-hidden rounded-[2.75rem] border border-white/10 bg-white/5 p-4 sm:p-6">
          <img
            src={snapshotScreenshot.src}
            alt="Ghost App mobile dashboard"
            width={snapshotScreenshot.width}
            height={snapshotScreenshot.height}
            loading="lazy"
            class="w-full max-w-sm object-contain drop-shadow-[0_25px_80px_rgba(0,0,0,0.35)] max-h-[420px]"
          />
        </div>
      </div>
    </div>
  </section>


  <section id="ghost-primer" class="space-y-8 py-16">
    <div class="surface-card space-y-6 bg-gradient-to-b from-white/10 to-transparent">
      <span class="tag">Ghost primer</span>
      <div class="space-y-4 text-white/80">
        <h2 class="text-3xl sm:text-4xl text-white">What is Ghost, and why build on it?</h2>
        <p class="text-lg">
          Ghost is the publishing platform powering modern newsletters, paid memberships, and independent media brands. Ghost App brings that ecosystem to your pocket.
        </p>
      </div>
      <div class="space-y-3">
        {primerPoints.map((point) => (
          <div class="flex items-start gap-3 text-base text-white/80">
            <span class="mt-1 h-2 w-2 rounded-full bg-primary shadow shadow-primary/40"></span>
            <p>{point}</p>
          </div>
        ))}
      </div>
      <a
        href="https://ghost.org"
        target="_blank"
        rel="noreferrer"
        class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-white transition hover:text-white/80"
      >
        Explore ghost.org →
      </a>
    </div>
  </section>

  <footer class="border-t border-white/10 py-10 text-sm text-white/70">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-white font-semibold">Ghost App</p>
        <p>Independent companion for Ghost publishers.</p>
      </div>
      <div class="flex flex-wrap gap-6">
        <a href="#waitlist" class="hover:text-white">Request beta access</a>
        <a
          href={X_PROFILE_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Open @ghostBlogApp on X"
          class="inline-flex items-center justify-center rounded-full border border-white/20 p-1.5 text-white hover:text-white/80 no-underline"
        >
          <XLogo class="h-4 w-4" />
        </a>
      </div>
    </div>
  </footer>

  <script type="module">
    const FEED_ENDPOINT = {JSON.stringify(X_FEED_ENDPOINT)};
    const X_HANDLE_DISPLAY = {JSON.stringify(X_HANDLE_DISPLAY)};
    const svgNS = 'http://www.w3.org/2000/svg';

    const createXLogo = () => {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('class', 'h-4 w-4 text-white');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('focusable', 'false');

      const path = document.createElementNS(svgNS, 'path');
      path.setAttribute('fill', 'currentColor');
      path.setAttribute('d', 'M1.5 0h5.7l5 7.7L16.8 0h5.7l-8.2 11.1L24 24h-5.7l-5-7.8L7.2 24H1.5l8.4-11.3L1.5 0z');
      svg.appendChild(path);

      return svg;
    };

    const createPostCard = (post) => {
      const article = document.createElement('article');
      article.className = 'surface-card flex flex-col gap-4 bg-gradient-to-b from-white/10 to-transparent p-6';
      article.id = post.id;

      const meta = document.createElement('div');
      meta.className = 'flex items-center justify-between text-xs uppercase tracking-[0.3em] text-white/60';

      const handle = document.createElement('span');
      handle.className = 'inline-flex items-center gap-2 tracking-[0.2em] text-white';
      handle.appendChild(createXLogo());
      const handleText = document.createElement('span');
      handleText.textContent = X_HANDLE_DISPLAY;
      handle.appendChild(handleText);
      meta.appendChild(handle);

      if (post.dateLabel) {
        const time = document.createElement('time');
        time.className = 'text-white/60';
        time.textContent = post.dateLabel;
        meta.appendChild(time);
      }

      const content = document.createElement('div');
      content.className = 'space-y-3';

      const title = document.createElement('p');
      title.className = 'text-xl font-semibold text-white';
      title.textContent = post.title;
      const excerpt = document.createElement('p');
      excerpt.className = 'text-sm text-white/70';
      excerpt.textContent = post.excerpt;
      content.append(title, excerpt);

      const link = document.createElement('a');
      link.className = 'inline-flex w-fit items-center gap-2 text-sm font-semibold text-primary no-underline hover:text-primary/80';
      link.href = post.link;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = 'Read on X →';

      article.append(meta, content, link);
      return article;
    };

    const renderLatestFromX = (container, posts) => {
      if (!Array.isArray(posts) || !posts.length) {
        return;
      }

      const fragment = document.createDocumentFragment();
      posts.forEach((post) => {
        if (!post || !post.link) {
          return;
        }
        fragment.appendChild(createPostCard(post));
      });

      if (!fragment.childNodes.length) {
        return;
      }

      container.innerHTML = '';
      container.appendChild(fragment);
    };

    const initLatestFromX = async () => {
      const container = document.querySelector('[data-x-feed]');
      if (!container) {
        return;
      }

      try {
        const endpoint = container.dataset.feedEndpoint || FEED_ENDPOINT;
        const response = await fetch(endpoint);
        if (!response.ok) {
          throw new Error(`Request failed with status ${response.status}`);
        }

        const payload = await response.json();
        renderLatestFromX(container, payload?.posts);
      } catch (error) {
        console.error('Failed to load Latest from X posts', error);
      }
    };

    initLatestFromX();
  </script>
</Layout>
