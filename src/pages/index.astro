---
import Layout from '../layouts/Layout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import XLogo from '../components/XLogo.astro';
import heroScreenshot from '../assets/Screenshot-1-Tilt.png';
import snapshotScreenshot from '../assets/Screenshot-2-Tilt.png';
import logoIcon from '../assets/Logo-icon.png';

const APP_STORE_URL = 'https://apps.apple.com/us/app/ecto/id6758278992';

const heroStats = [
  { label: 'Now on the App Store', value: 'Live' },
  { label: 'Built for Ghost publishers', value: 'iOS' },
];

const snapshotPoints = [
  'Browse your Ghost posts from a native iPhone workspace.',
  'Review published stories and drafts without opening a laptop.',
  'Jump from the mobile app into focused editing and publishing flows.',
];

const primerPoints = [
  'Ghost is an open-source publishing platform built for newsletters and modern media brands.',
  'Creators host their sites on Ghost and own their audience, subscriptions, and data.',
  'Ecto brings that publishing workflow to a native iPhone app.',
];

const X_HANDLE = 'ectoBlogApp';
const X_PROFILE_URL = `https://twitter.com/${X_HANDLE}`;
---

<Layout
  title="Ecto App | Ghost publishing from your iPhone"
  description="Get Ecto on the App Store, the native iPhone companion app for Ghost publishers."
>
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#020617]/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <img
          src={logoIcon.src}
          alt=""
          width="40"
          height="40"
          class="h-10 w-10 rounded-xl"
        />
        <div>
          <p class="text-lg font-semibold text-white">Ecto App</p>
          <p class="text-xs uppercase tracking-[0.3em] text-white/60">Ghost publishing for iPhone</p>
        </div>
      </div>
      <a href={APP_STORE_URL} target="_blank" rel="noreferrer" class="no-underline" aria-label="Open Ecto on the App Store">
        <AppStoreBadge compact />
      </a>
    </div>
  </header>

  <section id="hero" class="grid gap-10 pb-16 pt-6 text-white lg:grid-cols-[1.1fr_minmax(0,0.9fr)]">
    <div class="space-y-6">
      <span class="tag">Available now on the App Store</span>
      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">
        Manage your Ghost blog from your iPhone with Ecto.
      </h1>
      <p class="text-lg text-white/80 sm:text-xl">
        Ecto is a native mobile companion for Ghost publishers. Browse posts, review content, and keep publishing work moving wherever you are.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={APP_STORE_URL} target="_blank" rel="noreferrer" class="no-underline" aria-label="Open Ecto on the App Store">
          <AppStoreBadge />
        </a>
        <a href="#ghost-primer" class="inline-flex items-center gap-2 font-semibold text-white/80 transition hover:text-white">
          New to Ghost? Start here →
        </a>
      </div>
      <p class="text-sm text-white/70">
        Follow
        <a href={X_PROFILE_URL} target="_blank" rel="noreferrer" class="font-semibold text-white hover:text-primary">
          @ectoBlogApp
        </a>
        on X for release notes, support, and feature drops.
      </p>
      <div class="grid gap-6 pt-4 text-sm uppercase tracking-wide text-white/70 sm:grid-cols-2">
        {heroStats.map((stat) => (
          <div class="space-y-1">
            <p class="text-2xl font-bold text-white">{stat.value}</p>
            <p class="text-xs tracking-[0.3em] text-white/60">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="relative">
      <div class="absolute -inset-6 rounded-[2.75rem] bg-gradient-to-br from-primary/40 via-white/10 to-primary/20 blur-3xl"></div>
      <div class="surface-card relative flex items-center justify-center overflow-hidden rounded-[2.75rem] border border-white/10 bg-gradient-to-b from-white/10 to-white/0 p-8">
        <img
          src={heroScreenshot.src}
          alt="Ecto iPhone app showing a Ghost posts list"
          width={heroScreenshot.width}
          height={heroScreenshot.height}
          loading="eager"
          class="max-h-[640px] w-full max-w-sm object-contain drop-shadow-[0_25px_80px_rgba(0,0,0,0.35)]"
        />
      </div>
    </div>
  </section>

  <section id="snapshot" class="space-y-10 py-16">
    <div class="space-y-4">
      <span class="tag">Launch snapshot</span>
      <h2 class="text-3xl sm:text-4xl">A focused iPhone workspace for Ghost publishers.</h2>
      <p class="text-lg text-white/75 sm:max-w-3xl">
        Ecto keeps the publishing surface close at hand, with product screens that reflect the live App Store release.
      </p>
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.15fr_minmax(0,0.85fr)]">
      <div class="space-y-10">
        <div class="space-y-6 text-white/80">
          {snapshotPoints.map((point) => (
            <div class="flex items-start gap-3 text-base">
              <span class="mt-1 h-2 w-2 rounded-full bg-primary shadow shadow-primary/40"></span>
              <p>{point}</p>
            </div>
          ))}
          <div class="grid gap-4 pt-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">Ghost</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">Publishing backend</p>
            </div>
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">iPhone</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">Native mobile app</p>
            </div>
            <div class="rounded-2xl border border-white/15 p-4">
              <p class="text-3xl font-semibold text-white">Live</p>
              <p class="text-xs uppercase tracking-[0.3em] text-white/60">App Store release</p>
            </div>
          </div>
        </div>
      </div>
      <div class="surface-card flex items-center justify-center overflow-hidden rounded-[2.75rem] border border-white/10 bg-gradient-to-b from-white/10 to-white/0 p-8">
        <img
          src={snapshotScreenshot.src}
          alt="Ecto iPhone app showing a published Ghost post"
          width={snapshotScreenshot.width}
          height={snapshotScreenshot.height}
          loading="lazy"
          class="max-h-[640px] w-full max-w-sm object-contain drop-shadow-[0_25px_80px_rgba(0,0,0,0.35)]"
        />
      </div>
    </div>
  </section>

  <section id="ghost-primer" class="space-y-8 py-16">
    <div class="surface-card space-y-6 bg-gradient-to-b from-white/10 to-transparent">
      <span class="tag">Ectoprimer</span>
      <div class="space-y-4 text-white/80">
        <h2 class="text-3xl sm:text-4xl text-white">What is Ghost?</h2>
        <p class="text-lg">
          Ghost is the publishing platform powering modern newsletters, paid memberships, and independent media brands. Ecto brings that ecosystem to your pocket.
        </p>
      </div>
      <div class="space-y-3">
        {primerPoints.map((point) => (
          <div class="flex items-start gap-3 text-base text-white/80">
            <span class="mt-1 h-2 w-2 rounded-full bg-primary shadow shadow-primary/40"></span>
            <p>{point}</p>
          </div>
        ))}
      </div>
      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noreferrer"
        class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-white transition hover:text-white/80"
      >
        View Ecto on the App Store →
      </a>
    </div>
  </section>

  <section id="download" class="py-16">
    <div class="surface-card flex flex-col gap-6 bg-gradient-to-b from-white/10 to-transparent sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <img
          src={logoIcon.src}
          alt=""
          width="64"
          height="64"
          class="h-16 w-16 rounded-2xl"
          loading="lazy"
        />
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-white/60">Ready to publish from iPhone</p>
          <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">Ecto is live on the App Store.</h2>
        </div>
      </div>
      <a href={APP_STORE_URL} target="_blank" rel="noreferrer" class="no-underline" aria-label="Open Ecto on the App Store">
        <AppStoreBadge class="sm:min-w-60" />
      </a>
    </div>
  </section>

  <footer class="border-t border-white/10 py-10 text-sm text-white/70">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-white font-semibold">Ecto App</p>
        <p>Independent companion for Ghost publishers.</p>
      </div>
      <div class="flex flex-wrap gap-6">
        <a href={APP_STORE_URL} target="_blank" rel="noreferrer" class="font-semibold text-white no-underline hover:text-primary">
          App Store
        </a>
        <a
          href={X_PROFILE_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Open @ectoBlogApp on X"
          class="inline-flex items-center justify-center rounded-full border border-white/20 p-1.5 text-white hover:text-white/80 no-underline"
        >
          <XLogo class="h-4 w-4" />
        </a>
      </div>
    </div>
  </footer>

</Layout>
